{
    "name": "unknot/unknot",
    "description": "A local architecture explorer for PHP projects.",
    "type": "project",
    "require": {
        "php": "^8.5",
        "nikic/php-parser": "5.9.0"
    },
    "autoload": {
        "psr-4": {
            "Unknot\\": "src/"
        }
    },
    "scripts": {
        "test": [
            "@php tests/run.php",
            "@php tests/source-changes.php",
            "@php tests/source-special-file.php",
            "@php tests/source-concurrency.php",
            "@php tests/source-worker.php",
            "@php tests/symbol-kinds.php",
            "@php tests/class-context.php",
            "@php tests/syntax-cases.php",
            "@php tests/method-extraction.php",
            "@php tests/method-counterexamples.php",
            "@php tests/method-evidence.php",
            "@php tests/method-worker-validation.php",
            "@php tests/include-expressions.php",
            "@php tests/source-versions.php",
            "@php tests/database-touchpoints.php",
            "@php tests/web-service.php",
            "@php tests/demo-report.php",
            "@php tests/worker-connections.php",
            "@php tests/worker-isolation.php",
            "@php tests/worker-limits.php",
            "@php tests/worker-response.php",
            "@php tests/report-file.php",
            "@php tests/report-interruption.php",
            "@php tests/report-concurrency.php",
            "@php tests/cli-smoke.php"
        ]
    }
}
