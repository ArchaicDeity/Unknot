{
    "name": "legacylens/legacylens",
    "description": "A local architecture explorer for PHP projects.",
    "type": "project",
    "require": {
        "php": "^8.1",
        "nikic/php-parser": "4.14.0"
    },
    "autoload": {
        "psr-4": {
            "LegacyLens\\": "src/"
        }
    },
    "scripts": {
        "test": [
            "@php tests/run.php",
            "@php tests/symbol-kinds.php",
            "@php tests/class-context.php",
            "@php tests/cli-smoke.php",
            "@php tests/source-changes.php",
            "@php tests/source-concurrency.php",
            "@php tests/report-file.php"
        ]
    }
}
